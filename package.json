{
  "name": "mediopen-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "next dev",
    "build": "node --max-old-space-size=4096 node_modules/.bin/next build"
    "start": "next start",
    "lint": "next lint",
    "test:hema": "pnpm --filter '@salurama/hema-*' test",
    "test:hema:rls": "vitest run tests/hema/rls",
    "test:hema:e2e": "playwright test tests/hema/e2e",
    "db:hema:reset": "supabase db reset --linked",
    "db:hema:seed": "npx tsx supabase/seed/hema_seed.ts"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.2",
    "@salurama/hema-pdf": "workspace:*",
    "@salurama/hema-shared": "workspace:*",
    "@salurama/hema-validator": "workspace:*",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.47.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "browser-image-compression": "^2.0.2",
    "claude-mem": "github:thedotmack/claude-mem",
    "clsx": "^2.1.1",
    "gstack": "github:garrytan/gstack",
    "lucide-react": "^0.468.0",
    "mapbox-gl": "^3.20.0",
    "next": "^16.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "supabase": "^2.105.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
